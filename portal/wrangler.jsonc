{
  // Promotion requirements portal on Cloudflare Workers (free plan).
  // D1 and KV are created automatically on the first deploy.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "promotion-portal",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [{ "binding": "DB", "database_name": "promotion-portal" }],
  "kv_namespaces": [{ "binding": "FILES" }],
  "observability": { "enabled": true }
}
